rsource "../drivers/led_sensor/Kconfig"

mainmenu "LED Subsystem"

menuconfig LED_SUBSYSTEM
    bool "LED Subsystem"
    default y

if LED_SUBSYSTEM

choice LED_BLINK_SLEEP_TIME_CHOICE
    prompt "LED blink sleep time"
    default LED_BLINK_SLEEP_500MS

config LED_BLINK_SLEEP_250MS
    bool "250 ms"

config LED_BLINK_SLEEP_500MS
    bool "500 ms"

config LED_BLINK_SLEEP_1S
    bool "1 second"

config LED_BLINK_SLEEP_2S
    bool "2 seconds"

endchoice

config LED_BLINK_SLEEP_TIME
    int
    default 250 if LED_BLINK_SLEEP_250MS
    default 500 if LED_BLINK_SLEEP_500MS
    default 1000 if LED_BLINK_SLEEP_1S
    default 2000 if LED_BLINK_SLEEP_2S

config APP_HEARTBEAT_PERIOD_MS
    int "Heartbeat period (ms)"
    default 500
    range 100 2000

menuconfig LED_ADVANCED_SETTINGS
    bool "Advanced LED settings"
    default n

if LED_ADVANCED_SETTINGS

config LED_BRIGHTNESS
    int "LED brightness (0-100)"
    default 100
    range 0 100

config LED_FADE_DURATION
    int "LED fade duration time (ms)"
    default 500
    range 0 5000

endif

menu "Expert settings"
    visible if LED_ADVANCED_SETTINGS

config LED_CUSTOM_BLINK
    bool "Custom blink pattern"
    default n

endmenu

endif

source "Kconfig.zephyr"
